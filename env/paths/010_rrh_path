# Goal: add rrh scripts locations to path

rrh_2_path() {
  if [ -d "${HOME}/Workspace/redrover/libraries/scripts/bin" ];
    then export LPATH=${HOME}/Workspace/redrover/libraries/scripts/bin:${LPATH};
  fi
}

rrh_2_path

asdf_2_path() {
  # Preinitializa shims y ASDF_DATA_DIR antes de que asdf.sh cargue en asdf_init.
  # Necesario para que direnv_init y 04_java_path resuelvan herramientas correctamente.
  if [ -d "${HOME}/.asdf" ]; then
    export ASDF_DATA_DIR="${HOME}/.asdf"
    export LPATH="${ASDF_DATA_DIR}/shims:${LPATH}"
  fi
}

asdf_2_path