# Goal: Java version management via asdf

# Switch Java version for the current shell session.
# Usage: java_use <version>  (e.g. java_use adoptopenjdk-11.0.16+8)
java_use() {
  local version="$1"
  if [ -z "$version" ]; then
    echo "Usage: java_use <version>"
    echo ""
    java_versions
    return 1
  fi
  asdf shell java "$version"
}

# List installed Java versions and recent LTS candidates available to install.
java_versions() {
  echo "Installed:"
  asdf list java 2>/dev/null || echo "  asdf-java plugin not available"
  echo ""
  echo "Available (LTS: 11, 17, 21 | Latest: 24):"
  asdf list all java 2>/dev/null \
    | grep -E '^(temurin|adoptopenjdk|corretto|zulu|openjdk)-(11|17|21|24)\.' \
    | tail -20
}

# Install a Java version via asdf.
# Usage: java_install <version>  (e.g. java_install temurin-21.0.3+9)
java_install() {
  local version="$1"
  if [ -z "$version" ]; then
    echo "Usage: java_install <version>"
    echo ""
    java_versions
    return 1
  fi
  asdf install java "$version"
}

# Load the asdf-java plugin which auto-sets JAVA_HOME from .tool-versions
_java_hook="${ASDF_DATA_DIR:-$HOME/.asdf}/plugins/java/set-java-home.bash"
if [ -f "$_java_hook" ]; then
  # shellcheck source=/dev/null
  . "$_java_hook"
fi
unset _java_hook
