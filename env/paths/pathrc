#!/usr/bin/env bash
# pathrc
# --
# (c) Iver!
# Iván Jaimes <iver@iver.mx>
# --
# Goal: load the files from the paths of the available languages
#
# Each file named "<NN>_<name>_path" prepends its directories to LPATH.
# Files are loaded in byte order (LC_ALL=C), so a file loaded later takes
# precedence over the ones loaded before it.
#
# Checkout System Path Ordering
# echo -e ${PATH//:/\\n}

# set -o errexit
# set -o nounset
set -o pipefail

# Rebuild PATH without empty entries, the current directory or duplicates,
# keeping the first occurrence of each entry.
path_normalize() {
  local entry normalized=""
  local IFS=":"
  for entry in ${PATH}; do
    case "${entry}" in
      ""|".") continue ;;
    esac
    case ":${normalized}:" in
      *":${entry}:"*) ;;
      *) normalized="${normalized:+${normalized}:}${entry}" ;;
    esac
  done
  PATH="${normalized}"
  export PATH
}

load_file_path() {
  local path_file
  while IFS= read -r path_file; do
    [ -f "${path_file}" ] || continue
    # shellcheck source=/dev/null
    . "${path_file}"
  done < <(printf '%s\n' "$1"/[0-9]*_path | LC_ALL=C sort)
}

enable_jenv() {
  command -v jenv > /dev/null 2>&1 || return 0
  eval "$(jenv init -)"
  jenv enable-plugin export > /dev/null
  jenv enable-plugin maven > /dev/null
}

main() {
  local LPATH=""

  load_file_path "$1"

  PATH="${LPATH}:${PATH}"
  path_normalize

  # enable_jenv
}

main "$@"
