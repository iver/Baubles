# Goal: add rust locations to path

rust_2_path() {
  if [ -d "${HOME}/.cargo/bin" ];
    then export LPATH=${HOME}/.cargo/bin:${LPATH};
  fi
}

asdf_2_path() {
  export ASDF_DATA_DIR="${HOME}/.asdf"
  export LPATH=${ASDF_DATA_DIR}/shims:${LPATH};
}

rust_2_path
asdf_2_path