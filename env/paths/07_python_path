# Goal: add python locations to path

python_2_path() {
  [ -d "${HOME}/Library/Python/2.7/bin" ] && export LPATH=${HOME}/Library/Python/2.7/bin:${LPATH}

  # The python version comes from the asdf shims (see .tool-versions);
  # never add a specific asdf install directory here.
  return 0
}

python_2_path
