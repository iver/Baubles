# Append a line to a file unless it is already there, creating the file
# when it does not exist.
append_line_once() {
    local file="$1"
    local line="$2"

    if [ -f "${file}" ] && grep -qxF "${line}" "${file}"; then
        return 0
    fi
    printf '%s\n' "${line}" >> "${file}"
}

# Make ~/.bashrc load the repository setup for non-login shells.
create_bashrc() {
    local dot_files="$1"

    [ -L ~/.bashrc ] && unlink ~/.bashrc
    append_line_once ~/.bashrc ". \"${dot_files}/bashrc\""
}

# Remove every line equal to the given one, keeping the rest of the file.
remove_line() {
    local file="$1"
    local line="$2"

    [ -f "${file}" ] || return 0
    grep -vxF "${line}" "${file}" > "${file}.tmp" || true
    mv "${file}.tmp" "${file}"
}

# Make ~/.bash_profile a local file that sources the repository profile.
# Installers (Docker, gcloud, ...) append to ~/.bash_profile; keeping it
# out of the repository stops them from editing tracked files.
create_profile() {
    local dot_files="$1"

    [ -L ~/.bash_profile ] && unlink ~/.bash_profile
    append_line_once ~/.bash_profile ". \"${dot_files}/iver_profile\""
}

create_vim_data() {
  if [ ! -d ~/.vim ]; then
    git clone https://github.com/iver/vitamine.git ~/.vim
    chmod +x ~/.vim/install.sh
    # shellcheck source=/dev/null
    source ~/.vim/install.sh
  fi

  if [ -d ~/.vim/bundle/vimproc ]; then
    cd ~/.vim/bundle/vimproc && make
  fi
}

link_dot_files() {
  dot_files="$1"
  [ -f ~/.ctags ] || ln -s "${dot_files}/ctags" ~/.ctags
  [ -f ~/.gitconfig ] || ln -s "${dot_files}/gitconfig" ~/.gitconfig
  [ -f ~/.gitignore_global ] || ln -s "${dot_files}/gitignore_global" ~/.gitignore_global
  [ -f ~/.iex.exs ] || ln -s "${dot_files}/iex.exs" ~/.iex.exs
  [ -f ~/.nanorc ] || ln -s "${dot_files}/nanorc" ~/.nanorc
  [ -f ~/.psqlrc ] || ln -s "${dot_files}/psqlrc" ~/.psqlrc
  [ -f ~/.spacemacs ] || ln -s "${dot_files}/spacemacs" ~/.spacemacs
  [ -f ~/.tmux.conf ] || ln -s "${dot_files}/tmux.conf" ~/.tmux.conf
}

remove_dot_files() {
    local dot_files="${1:-${PROJECT_PATH}/dotfiles}"

    [ -f ~/.ctags ] && unlink "${HOME}/.ctags"
    [ -f ~/.gitconfig ] && unlink "${HOME}/.gitconfig"
    [ -f ~/.gitignore_global ] && unlink "${HOME}/.gitignore_global"
    [ -f ~/.iex.exs ] && unlink "${HOME}/.iex.exs"
    [ -f ~/.nanorc ] && unlink "${HOME}/.nanorc"
    [ -f ~/.psqlrc ] && unlink "${HOME}/.psqlrc"
    [ -f ~/.spacemacs ] && unlink "${HOME}/.spacemacs"
    [ -f ~/.tmux.conf ] && unlink "${HOME}/.tmux.conf"
    
    if [ -L ~/.bash_profile ]; then
        unlink "${HOME}/.bash_profile"
    else
        remove_line ~/.bash_profile ". \"${dot_files}/iver_profile\""
    fi
    remove_line ~/.bashrc ". \"${dot_files}/bashrc\""
    rm -f ~/.iver_profile

    # if [ -d ~/.vim ]; then
    #     rm -rf ~/.vim;
    #     rm ~/.vimrc;
    # fi
}

ssh_config() {
    templates="$1"
    [ -f ~/.ssh/keys_to_load ] || cp "${templates}/templates/keys_to_load" ~/.ssh/keys_to_load
}

sync_submodule() {
  git submodule init .
  git submodule update
}