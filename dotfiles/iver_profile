set -o pipefail

CONF_FILES=~/Config
ENV_FILES="${CONF_FILES}/env"
DOT_FILES="${CONF_FILES}/dotfiles"
PATH_FILES="${CONF_FILES}/env/paths"
UTILS_PATH="${CONF_FILES}/scripts/utils"

export CONF_FILES
export ENV_FILES
export DOT_FILES
export PATH_FILES
export UTILS_PATH

load_env_files() {
  # shellcheck source=/dev/null
  . "${ENV_FILES}/env"
  # shellcheck source=/dev/null
  . "${ENV_FILES}/alias"
  # shellcheck source=/dev/null
  . "${PATH_FILES}/pathrc" "${PATH_FILES}"
  # shellcheck source=/dev/null
  source ${ENV_FILES}/git/git-prompt.sh
  # shellcheck source=/dev/null
  # source ~/.fonts/*.sh
}

load_ssh_keys() {
  # shellcheck source=/dev/null
  if [[ -f ${UTILS_PATH}/ssh_keys ]]; then
    . ${UTILS_PATH}/ssh_keys
    read_on_init
  fi
}

set_git_prompt() {
  local git_file="${ENV_FILES}/git/git-prompt.sh"
  local origin="https://raw.githubusercontent.com/git/git/refs/heads/master/contrib/completion/git-prompt.sh"
  if [ ! -f "${git_file}" ]; then
    curl -o "${git_file}" ${origin}
  fi
  # shellcheck source=/dev/null
  source "${git_file}"
}

load_bash_completion() {
  local bash_completion
  # bash-completion@2: carga perezosa; registra `git` (y ramas) al primer uso.
  bash_completion="$(brew --prefix)/etc/profile.d/bash_completion.sh"
  # shellcheck source=/dev/null
  [ -r "$bash_completion" ] && . "$bash_completion"
}

pyenv_init() {
  eval "$(pyenv init --path)"
  if command -v pyenv 1>/dev/null 2>&1; then
    eval "$(pyenv init -)"
  fi
}

google_sdk_init() {
  # The next line updates PATH for the Google Cloud SDK.
  if [ -f '/Users/iver/Google/google-cloud-sdk/path.bash.inc' ];
    then
      # shellcheck source=/dev/null
      . '/Users/iver/Google/google-cloud-sdk/path.bash.inc';
  fi

  # The next line enables shell command completion for gcloud.
  if [ -f '/Users/iver/Google/google-cloud-sdk/completion.bash.inc' ];
    then
      # shellcheck source=/dev/null
      . '/Users/iver/Google/google-cloud-sdk/completion.bash.inc';
  fi
}

nvm_init() {
  NVM_DIR="$(brew --prefix nvm)"
  export NVM_DIR
  # loads nvm
  # shellcheck source=/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  # loads nvm bash_completion
  # shellcheck source=/dev/null
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}

direnv_init() {
  eval "$(direnv hook bash)"
}

asdf_init() {
  local ASDF_PATH
  ASDF_PATH="$(brew --prefix asdf)"

  # shellcheck source=/dev/null
  . "${ASDF_PATH}/libexec/asdf.sh"
  # shellcheck source=/dev/null
  . "${ASDF_PATH}/etc/bash_completion.d/asdf"
}

vim_alias() {
  if (command -v brew && brew list --formula | grep -c vim ) > /dev/null 2>&1; then
    alias vim='$(brew --prefix vim)/bin/vim'
  fi
}

set_default_editor() {
  if (command -v brew && brew list --formula | grep -c nvim ) > /dev/null 2>&1; then
    local editor_path
    editor_path="$(brew --prefix nvim)/bin/nvim"
    export EDITOR="$editor_path"
  fi
}

validate_shell_env() {
  local ok=0 fail=0

  _chk() {
    if [ "${2}" = "ok" ]; then
      printf "  [OK]   %s\n" "${1}"; ok=$((ok + 1))
    else
      printf "  [FAIL] %s — %s\n" "${1}" "${2}"; fail=$((fail + 1))
    fi
  }

  echo "=== Shell Environment Validation ==="
  echo ""

  echo "-- asdf --"
  _chk "ASDF_DIR exported"       "$([ -n "${ASDF_DIR}" ]      && echo ok || echo 'not set — asdf.sh not sourced')"
  _chk "ASDF_DATA_DIR exported"  "$([ -n "${ASDF_DATA_DIR}" ] && echo ok || echo 'not set')"
  _chk "shims in PATH"           "$(echo "${PATH}" | grep -q 'asdf/shims' && echo ok || echo 'shims not found in PATH')"
  _chk "asdf binary reachable"   "$(command -v asdf >/dev/null && echo ok || echo 'not found')"

  echo ""
  echo "-- Elixir --"
  _chk "mix reachable"    "$(command -v mix    >/dev/null && echo ok || echo 'not found')"
  _chk "elixir reachable" "$(command -v elixir >/dev/null && echo ok || echo 'not found')"
  if command -v mix >/dev/null 2>&1; then
    _chk "mix via asdf shim" "$(which mix | grep -q asdf && echo ok || echo "unexpected path: $(which mix)")"
  fi

  echo ""
  echo "-- direnv --"
  _chk "direnv binary reachable" "$(command -v direnv >/dev/null && echo ok || echo 'not found')"
  _chk "direnv hooked in shell"  "$(type _direnv_hook >/dev/null 2>&1 && echo ok || echo 'hook missing — direnv not initialized')"

  echo ""
  printf "=== %d passed, %d failed ===\n" "${ok}" "${fail}"
  unset -f _chk
  return ${fail}
}

main() {
  load_env_files
  load_ssh_keys
  load_bash_completion
  # pyenv_init
  google_sdk_init
  direnv_init
  # nvm_init

  asdf_init
  # vim_alias
  set_default_editor

  if [ -f ~/.profile ]; then
    # shellcheck source=/dev/null
    source ~/.profile
  fi
  set_git_prompt
}

main "$@"

