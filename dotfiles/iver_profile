    eval "$__conda_setup"
else
    if [ -f "/Users/iver/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/Users/iver/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/Users/iver/miniconda3/bin:$PATH"
