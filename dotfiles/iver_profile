# set -o errexit
# set -o nounset
set -o pipefail

# export LC_ALL=en_US.UTF-8
# export LANG=en_US.UTF-8

CONF_FILES=~/Config
ENV_FILES="${CONF_FILES}/env"
DOT_FILES="${CONF_FILES}/dotfiles"
PATH_FILES="${CONF_FILES}/env/paths"
UTILS_PATH="${CONF_FILES}/scripts/utils"

export CONF_FILES
export ENV_FILES
export DOT_FILES
export PATH_FILES
export UTILS_PATH

load_env_files() {
  # shellcheck source=/dev/null
  . "${ENV_FILES}/env"
  # shellcheck source=/dev/null
  . "${ENV_FILES}/alias"
  # shellcheck source=/dev/null
  . "${ENV_FILES}/alias_aws"
  # shellcheck source=/dev/null
  . "${PATH_FILES}/pathrc" "${PATH_FILES}"
  # shellcheck source=/dev/null
  # . "${ENV_FILES}/git/git-completion.bash"
  # shellcheck source=/dev/null
  source ${ENV_FILES}/git/git-prompt.sh
  # shellcheck source=/dev/null
  source ~/.fonts/*.sh
}

load_ssh_keys() {
  # shellcheck source=/dev/null
  if [[ -f ${UTILS_PATH}/ssh_keys ]]; then
    . ${UTILS_PATH}/ssh_keys
    read_on_init
  fi
}

brew_autocomplete() {
  if [ -d "$(brew --prefix)/etc/bash_completion.d/" ]; then
    # shellcheck source=/dev/null
    for link in "$(brew --prefix)"/etc/bash_completion.d/*; do
      source "${link}"
    done
  else
    echo "run: brew install git bash-completion"
  fi
}

pyenv_init() {
  eval "$(pyenv init --path)"
  if command -v pyenv 1>/dev/null 2>&1; then
    eval "$(pyenv init -)"
  fi
}

google_sdk_init() {
  # The next line updates PATH for the Google Cloud SDK.
  if [ -f '/Users/iver/Google/google-cloud-sdk/path.bash.inc' ];
    then
      # shellcheck source=/dev/null
      . '/Users/iver/Google/google-cloud-sdk/path.bash.inc';
  fi

  # The next line enables shell command completion for gcloud.
  if [ -f '/Users/iver/Google/google-cloud-sdk/completion.bash.inc' ];
    then
      # shellcheck source=/dev/null
      . '/Users/iver/Google/google-cloud-sdk/completion.bash.inc';
  fi
}

nvm_init() {
  NVM_DIR="$(brew --prefix nvm)"
  export NVM_DIR
  # loads nvm
  # shellcheck source=/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  # loads nvm bash_completion
  # shellcheck source=/dev/null
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}

powerline_init() {
  export PATH=$PATH:$HOME/.local/bin
  export LC_ALL=en_US.UTF-8
  powerline-daemon -q
  POWERLINE_BASH_CONTINUATION=1
  POWERLINE_BASH_SELECT=1
  # POWERLINE_CONFIG_COMMAND=$(which powerline-config)
  # POWERLINE_COMMAND="$($POWERLINE_CONFIG_COMMAND shell command)"

  # export POWERLINE_CONFIG_COMMAND
  export POWERLINE_BASH_CONTINUATION
  export POWERLINE_BASH_SELECT
  # export POWERLINE_COMMAND

  source "${HOME}/.local/lib/python3.10/site-packages/powerline/bindings/bash/powerline.sh"
  # . ${HOME}/Library/Python/3.8/lib/python/site-packages/powerline/bindings/bash/powerline.sh
}

direnv_init() {
  eval "$(direnv hook bash)"
}

asdf_init() {
  local ASDF_PATH
  ASDF_PATH="$(brew --prefix asdf)"

  # shellcheck source=/dev/null
  . "${ASDF_PATH}/etc/bash_completion.d/asdf"
}

vim_alias() {
  if (command -v brew && brew list --formula | grep -c vim ) > /dev/null 2>&1; then
    alias vim='$(brew --prefix vim)/bin/vim'
  fi
}

iterm_shell_integration() {
    ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX=no
    ITERM_SHELL_INTEGRATION_INSTALLED=Yes

    export ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX
    export ITERM_SHELL_INTEGRATION_INSTALLED
    if [ "$TERM_PROGRAM" = "iTerm.app" ]; then
        # shellcheck source=/dev/null
        source "${CONF_FILES}/maintenance/.iterm2_shell_integration.bash"
    fi
}

main() {
  load_env_files
  load_ssh_keys
  # brew_autocomplete
  # pyenv_init
  google_sdk_init
  # nvm_init
  direnv_init
  asdf_init
  # vim_alias
  # powerline_init
  # iterm_shell_integration

  if [ -f ~/.profile ]; then
    # shellcheck source=/dev/null
    . ~/.profile
  fi

}

main "$@"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
